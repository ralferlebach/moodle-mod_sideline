.DS_Store
Thumbs.db
desktop.ini
*Zone.Identifier

# IDE
.idea/
.vscode/
*.iml
*.iws

# Node (browser harness in tests/playwright)
node_modules/
npm-debug.log*

# PHP / Composer
vendor/
composer.lock

# moodle-plugin-ci working directories, only at the top level: an unanchored "ci/" would also
# hide tools/ci/ from git.
/ci/
/moodle/

# PHPUnit / coverage
.phpunit.result.cache
.phpunit.cache/
coverage/
*.clover

# Behat screenshots
behatfaildumps/

# Temporary / backup files
*.bak
*.tmp
*.swp
*~

# Local developer overrides
.env
.env.local

# Load-test downloads and run artefacts (harness itself is versioned)
tests/load/.load-env
tests/load/k6
tests/load/*.tgz

# Playwright run artefacts
tests/playwright/test-results/
tests/playwright/playwright-report/
tests/playwright/.pw-env
